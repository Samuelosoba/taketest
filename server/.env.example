# Local development uses SQLite. Production (Vercel) uses PostgreSQL, e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require   (pooled)
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require (direct, for migrations)
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=4000
APP_URL=http://127.0.0.1:5175
# Production only: protects GET /api/cron/sweep (background work on Vercel).
CRON_SECRET=
PAYSTACK_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AssessmentDesk <noreply@example.com>
