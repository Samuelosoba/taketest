generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
// Production: PostgreSQL (e.g. Neon). DATABASE_URL may be a pooled connection;
// migrations use the direct one. Local development generates a SQLite copy
// of this file (scripts/local-schema.mjs).
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Institution {
  id String @id @default(cuid())
  name String
  slug String @unique
  email String
  phone String @default("")
  address String @default("")
  website String @default("")
  description String @default("")
  status String @default("ACTIVE")
  settings Json
  allowedOrigins Json?
  createdAt DateTime @default(now())
  users User[]
  courses Course[]
  exams Exam[]
  questions Question[]
  subscriptions Subscription[]
  apiKeys ApiKey[]
  webhookEndpoints WebhookEndpoint[]
}
model User {
  id String @id @default(cuid())
  institutionId String?
  institution Institution? @relation(fields: [institutionId], references: [id])
  externalId String?
  name String
  // Null for partner-managed students, who never sign in with a password.
  email String? @unique
  password String
  role String @default("STUDENT")
  active Boolean @default(true)
  emailVerified Boolean @default(false)
  studentNumber String?
  createdAt DateTime @default(now())
  attempts ExamAttempt[]
  payments Payment[]
  sessions RefreshToken[]
  tokens AccountToken[]
  @@index([institutionId, role])
  @@unique([institutionId, externalId])
}
model Course {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  externalId String?
  title String
  code String
  description String
  status String @default("PUBLISHED")
  createdAt DateTime @default(now())
  exams Exam[]
  @@unique([institutionId, code])
  @@unique([institutionId, externalId])
}
model Exam {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  externalId String?
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  title String
  description String
  duration Int @default(30)
  passMark Int @default(50)
  price Int @default(0)
  currency String @default("NGN")
  maxAttempts Int @default(1)
  status String @default("DRAFT")
  startsAt DateTime?
  endsAt DateTime?
  shuffleQuestions Boolean @default(true)
  shuffleOptions Boolean @default(true)
  releaseResults Boolean @default(true)
  fullscreen Boolean @default(false)
  cameraRequired Boolean @default(false)
  // OPEN: listed for students. LAUNCH_ONLY: started only through a partner launch.
  accessMode String @default("OPEN")
  createdAt DateTime @default(now())
  questions ExamQuestion[]
  attempts ExamAttempt[]
  payments Payment[]
  @@index([institutionId, status])
  @@unique([institutionId, externalId])
}
model Question {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  externalId String?
  text String
  type String @default("SINGLE")
  difficulty String @default("MEDIUM")
  subject String @default("")
  marks Int @default(1)
  options Json
  acceptedAnswers Json
  imageUrl String @default("")
  createdAt DateTime @default(now())
  exams ExamQuestion[]
  @@index([institutionId, type])
  @@unique([institutionId, externalId])
}
model ExamQuestion {
  examId String
  questionId String
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@id([examId, questionId])
}
model ExamAttempt {
  id String @id @default(cuid())
  institutionId String
  examId String
  exam Exam @relation(fields: [examId], references: [id])
  studentId String
  student User @relation(fields: [studentId], references: [id])
  number Int
  status String @default("STARTED")
  startedAt DateTime @default(now())
  expectedEndAt DateTime
  submittedAt DateTime?
  snapshot Json
  answers Json
  ip String
  userAgent String
  version Int @default(0)
  lastSeenAt DateTime?
  disconnectedAt DateTime?
  launchId String?
  result Result?
  violations ExamViolation[]
  @@unique([studentId, examId, number])
  @@index([institutionId, status, expectedEndAt])
  @@index([status, lastSeenAt])
}
model Result {
  id String @id @default(cuid())
  institutionId String
  attemptId String @unique
  attempt ExamAttempt @relation(fields: [attemptId], references: [id])
  totalMarks Int
  obtainedMarks Float
  percentage Float
  grade String
  passed Boolean
  status String
  breakdown Json
  released Boolean
  createdAt DateTime @default(now())
  certificate Certificate?
  @@index([institutionId, released])
}
model Payment {
  id String @id @default(cuid())
  institutionId String
  studentId String
  student User @relation(fields: [studentId], references: [id])
  examId String
  exam Exam @relation(fields: [examId], references: [id])
  reference String @unique
  amount Int
  currency String @default("NGN")
  status String @default("PENDING")
  paidAt DateTime?
  createdAt DateTime @default(now())
  @@index([institutionId, studentId, examId, status])
}
model Certificate {
  id String @id @default(cuid())
  resultId String @unique
  result Result @relation(fields: [resultId], references: [id])
  code String @unique
  createdAt DateTime @default(now())
}
model RefreshToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model AccountToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  expiresAt DateTime
}
model ExamViolation {
  id String @id @default(cuid())
  attemptId String
  attempt ExamAttempt @relation(fields: [attemptId], references: [id])
  type String
  clientEventId String? @unique
  createdAt DateTime @default(now())
  @@index([attemptId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  institutionId String?
  userId String?
  apiKeyId String?
  action String
  targetId String
  createdAt DateTime @default(now())
  @@index([institutionId, createdAt])
}
model Subscription {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  plan String @default("STARTER")
  status String @default("TRIAL")
  endsAt DateTime
  createdAt DateTime @default(now())
}
// Partner integration. Secret values are stored only as SHA-256 hashes, except
// webhook signing secrets, which must be readable to sign deliveries.
model ApiKey {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  name String
  prefix String @unique
  hash String @unique
  scopes Json
  lastUsedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  @@index([institutionId])
}
model WebhookEndpoint {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
  url String
  secret String
  events Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]
  @@index([institutionId])
}
model WebhookDelivery {
  id String @id @default(cuid())
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId String
  eventType String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastStatus Int?
  lastError String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}
model LaunchToken {
  id String @id
  institutionId String
  userId String
  examId String
  returnUrl String @default("")
  usedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([institutionId, createdAt])
}
model IdempotencyKey {
  institutionId String
  key String
  requestHash String
  status Int
  response Json
  createdAt DateTime @default(now())
  @@id([institutionId, key])
  @@index([createdAt])
}
